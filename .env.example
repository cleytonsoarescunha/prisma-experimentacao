# Copie este arquivo para .env.local e preencha os valores. Nunca suba o .env.local para o GitHub.

# Supabase (Fatia 2): Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Chave secreta (secret key "sb_secret_..." ou a antiga service_role). Usada só no servidor.
SUPABASE_SECRET_KEY=
# Chave pública (publishable "sb_publishable_..." ou a antiga anon). Usada no login (Fatia 5).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA (Fatia 3)
IA_FORNECEDOR=gemini
GEMINI_API_KEY=

# Time InovAI: e-mails separados por vírgula (Fatia 5)
INOVAI_EMAILS=
